<!--
  Indonesian resources. Mirrored in values-id/ and values-in/, which MUST stay byte-identical:
  older Android platforms only match the legacy "in" qualifier, newer platforms match "id".
-->
<resources>
    <!-- Cycle timeline filter chips -->
    <string name="filter_all">Semua</string>
    <string name="filter_period">Haid</string>
    <string name="filter_ovulation">Ovulasi</string>
    <string name="filter_fertile">Masa Subur</string>

    <!-- Cycle timeline row labels -->
    <string name="cycle_row_range_ongoing">%1$s – Aktif</string>
    <string name="cycle_row_cycle_day_active">Hari ke-%1$d (Aktif)</string>
    <string name="cycle_row_length_days">%1$d hari</string>

    <!-- Countdowns and counters (Indonesian has no plural inflection) -->
    <plurals name="app_days_left">
        <item quantity="one">%1$d hari lagi</item>
        <item quantity="other">%1$d hari lagi</item>
    </plurals>
    <plurals name="app_days_late">
        <item quantity="one">Terlambat %1$d hari</item>
        <item quantity="other">Terlambat %1$d hari</item>
    </plurals>
    <plurals name="report_cycle_count">
        <item quantity="one">%1$d siklus</item>
        <item quantity="other">%1$d siklus</item>
    </plurals>
</resources>
