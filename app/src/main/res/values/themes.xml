<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Edge-to-edge compliant for Android 15+) -->
    <style name="Theme.CycleJournal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash Screen theme using androidx.core.splashscreen -->
    <style name="Theme.CycleJournal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_pdf_header</item>
        <item name="postSplashScreenTheme">@style/Theme.CycleJournal</item>
    </style>
</resources>
